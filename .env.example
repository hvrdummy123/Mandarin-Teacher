# Copy to .env and fill in what you use. Nothing here is required to start the shell;
# /readyz will report which providers and data are missing.

# Bind (browsers only grant mic on localhost or HTTPS — see README)
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite
DATABASE_URL=sqlite:///./data/duihua.db

# LLM — free-tier model ids change; check provider docs when updating.
# Primary: Google Gemini free tier
GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash-lite
# Secondary: OpenRouter free models (ids ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_REPLY_MODEL=qwen/qwen-2.5-7b-instruct:free
OPENROUTER_ANALYSIS_MODEL=qwen/qwen-2.5-7b-instruct:free
# Optional local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REPLY_MODEL=qwen2.5:7b
OLLAMA_ANALYSIS_MODEL=qwen2.5:7b

# Ordered fallback. Add ollama when running locally without cloud keys.
LLM_PROVIDERS=gemini,openrouter

# STT / TTS
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_CACHE_DIR=./data/tts_cache

# Paths
DATA_DIR=./data
DICTIONARY_DB_PATH=./data/dictionary.db

# App
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
DAILY_XP_GOAL=100
LEVEL_OUT_OF_VOCAB_THRESHOLD=0.12
UPLOAD_MAX_BYTES=8388608
AUDIO_MAX_SECONDS=60
